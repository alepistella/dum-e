<?xml version="1.0"?>
<sdf version="1.10"><world name="reset_metadata_review">
 <physics name="step" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
 <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
 <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
 <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre</render_engine></plugin>
 <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
 <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.15 0.15 0.15 1</background><shadows>false</shadows></scene>
 <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><direction>-1 0 -1</direction><diffuse>1 1 1 1</diffuse><cast_shadows>false</cast_shadows></light>
 <model name="wall"><static>true</static><pose>5.1 2 0.5 0 0 0</pose><link name="wall_link"><visual name="wall_visual"><geometry><box><size>0.2 8 1</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual><collision name="wall_collision"><geometry><box><size>0.2 8 1</size></box></geometry></collision></link></model>
 <model name="sensor_rig"><static>true</static><pose>3 2 0.5 0 0 0</pose><link name="sensor_link">
  <inertial><mass>1</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
  <sensor name="review_lidar" type="gpu_lidar"><topic>review/lidar</topic><update_rate>10</update_rate><lidar><scan><horizontal><samples>31</samples><resolution>1</resolution><min_angle>-0.6</min_angle><max_angle>0.6</max_angle></horizontal><vertical><samples>3</samples><resolution>1</resolution><min_angle>-0.01</min_angle><max_angle>0.01</max_angle></vertical></scan><range><min>0.1</min><max>10</max><resolution>0.001</resolution></range></lidar><always_on>true</always_on></sensor>
  <sensor name="review_camera" type="camera"><topic>review/camera</topic><update_rate>5</update_rate><camera><horizontal_fov>1.0</horizontal_fov><image><width>64</width><height>48</height><format>R8G8B8</format></image><clip><near>0.1</near><far>10</far></clip></camera><always_on>true</always_on></sensor>
  <sensor name="review_imu" type="imu"><topic>review/imu</topic><update_rate>20</update_rate><always_on>true</always_on></sensor>
 </link></model>
</world></sdf>
